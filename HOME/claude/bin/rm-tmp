#!/usr/bin/env bash
# /tmp (and /private/tmp) 配下のパスに限定して rm を実行するラッパー。
# settings.json の permissions.deny には Bash(rm:*) 等の広いルールがあり、
# より具体的な allow ルールを追加しても deny が常に優先されるため無効。
# そのため、対象を /tmp 配下に固定した専用コマンドとして allow する。
set -euo pipefail

script_name=$(basename "$0")

end_of_options=false
for arg in "$@"; do
  if [[ "$end_of_options" == false ]]; then
    case "$arg" in
      --) end_of_options=true; continue ;;
      -*) continue ;;
    esac
  fi

  resolved=$(realpath -- "$arg" 2>/dev/null) || {
    echo "$script_name: cannot resolve path: $arg" >&2
    exit 1
  }
  case "$resolved" in
    /tmp/*|/private/tmp/*) ;;
    *)
      echo "$script_name: refusing to remove path outside /tmp (resolved: $resolved): $arg" >&2
      exit 1
      ;;
  esac
done

exec rm "$@"
