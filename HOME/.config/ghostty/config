# 自動更新
auto-update = "download"
auto-update-channel = "stable"

# GUIの表示言語
language = ja

# shell 統合
shell-integration = "fish"
# メインフォント
# font-family = "Hack Nerd Font Mono"
# font-family =  "Annotation Mono"
font-family = "AnnotationM Nerd Font Mono"
# サブフォント(フォールバック)
font-family = "HackGen Console NF"
# italic スタイル表示を無効
font-style-italic = false
# bold-italic スタイル表示を無効
font-style-bold-italic = false
# フォントが対応している場合、フォントの線を太く描画する
font-thicken = true

# フォントサイズ
font-size = 13
# 行の高さの調整
adjust-cell-height = "-15%"

# カラーテーマ
theme = "Kanagawa Dragon"

# ウィンドウの左右の余白
window-padding-x = 10
# ウィンドウの背景透過度
background-opacity = 0.9
# 背景のぼかし度合い
background-blur-radius = 15
# カーソルのスタイル
cursor-style = block
# カーソルの点滅
cursor-style-blink = true

# クリップボード読み取り
clipboard-read = "allow"
# クリップボード書き込み
clipboard-write = "allow"
# コピー時に末尾の空白をトリム
clipboard-trim-trailing-spaces = true


############
# KeyBinds #
############
# デフォルトのキーバインドを全て無効
keybind = clear

# ホットキーウィンドウの設定
quick-terminal-position = "top"
quick-terminal-screen = "main"
quick-terminal-animation-duration = 0.1

# ホットキーウィンドウ表示トグルのキーバインド
keybind = "global:shift+opt+space=toggle_quick_terminal"

# この設定ファイルを開く
keybind = "cmd+,=open_config"
# 設定ファイルをリロードする
keybind = "unconsumed:cmd+;=reload_config"

# 新しいウィンドウを開く
keybind  = "cmd+n=new_window"

# 新しいタブを開く
keybind = "cmd+t=new_tab"

# ペインを垂直分割(右)
keybind = "cmd+d=new_split:right"
# ペインを垂直分割(左)
keybind = "cmd+opt+d=new_split:left"

# ペインを垂直分割(下)
keybind = "cmd+shift+d=new_split:down"

# 現在開いている画面(Window|Tab|split)を閉じる
keybind = "cmd+w=close_surface"

# 分割ペインのフォーカス移動キーバインド
keybind = "ctrl+opt+shift+l=goto_split:right"
keybind = "ctrl+opt+shift+h=goto_split:left"
keybind = "ctrl+opt+shift+k=goto_split:top"
keybind = "ctrl+opt+shift+j=goto_split:bottom"
keybind = "ctrl+opt+shift+tab=goto_split:next"

# 分割したペインのリサイズキーバインド
keybind = "ctrl+shift+l=resize_split:right,20"
keybind = "ctrl+shift+h=resize_split:left,20"
keybind = "ctrl+shift+k=resize_split:up,20"
keybind = "ctrl+shift+j=resize_split:down,20"
keybind = "shift+enter=text:\n"

# 選択したテキストをクリップボードにコピーする
keybind = "cmd+c=copy_to_clipboard"
# クリップボードから貼り付けする
keybind = "cmd+v=paste_from_clipboard"
