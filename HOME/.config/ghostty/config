# 自動更新
auto-update = "download"
auto-update-channel = "stable"

# GUIの表示言語
language = ja

# shell 統合
shell-integration = "fish"
# メインフォント
# font-family = "Hack Nerd Font Mono"
# font-family =  "Annotation Mono"
font-family = "AnnotationM Nerd Font Mono"
# サブフォント(フォールバック)
font-family = "HackGen Console NF"
# italic スタイル表示を無効
font-style-italic = false
# bold-italic スタイル表示を無効
font-style-bold-italic = false
# フォントが対応している場合、フォントの線を太く描画する
font-thicken = true

# フォントサイズ
font-size = 13
# 行の高さの調整
adjust-cell-height = "-15%"

# カラーテーマ
theme = "Kanagawa Dragon"

# macOSの左Option Key を ALT キーとして扱う
macos-option-as-alt = left

# ウィンドウの左右の余白
window-padding-x = 10
# ウィンドウの背景透過度
background-opacity = 0.9
# 背景のぼかし度合い
background-blur-radius = 15
# カーソルのスタイル
cursor-style = block
# カーソルの点滅
cursor-style-blink = true

# クリップボード読み取り
clipboard-read = "allow"
# クリップボード書き込み
clipboard-write = "allow"
# コピー時に末尾の空白をトリム
clipboard-trim-trailing-spaces = true

# クイックターミナルの位置 (top|bottom|left|right|center)
quick-terminal-position = "bottom"
# クイックターミナルのサイズ (幅/高さ)
quick-terminal-size = "30%,100%"
# クイックターミナルが表示される画面(main|mouse|macos-menu-bar)
quick-terminal-screen = "mouse"
# クイックターミナルのアニメーションの再生時間
quick-terminal-animation-duration = 0.1
# クイックターミナルがフォーカスを失なった時に自動で非表示
quick-terminal-autohide = true
# クイックターミナルが仮想デスクトップを切り替えても追従 (move|remain)
quick-terminal-space-behavior = "move"
# クイックターミナルがキーボード入力を受け付ける条件(none|on-demand|exclusive)
quick-terminal-keyboard-interactivity = "on-demand"


############
# KeyBinds #
############
# デフォルトのキーバインドを全て無効
keybind = clear

# 新しいウィンドウを開く
keybind  = "super+n=new_window"
# 新しいタブを開く
keybind = "super+t=new_tab"
# ペインを垂直分割(右)
keybind = "super+l=new_split:right"
# ペインを垂直分割(左)
keybind = "super+h=new_split:left"
# ペインを垂直分割(上)
keybind = "super+k=new_split:up"
# ペインを垂直分割(下)
keybind = "super+j=new_split:down"

# ghostty を終了
keybind = "super+q=quit"
# 現在開いている画面(Window|Tab|split)を閉じる
keybind = "super+w=close_surface"
# クリップボードにコピー
keybind = "super+c=copy_to_clipboard"
# クリップボードから貼り付け
keybind = "super+v=paste_from_clipboard"

# ホットキーウィンドウ表示トグルのキーバインド
keybind = "global:shift+opt+space=toggle_quick_terminal"

# この設定ファイルを開く
keybind = "super+,=open_config"
# 設定ファイルをリロードする
keybind = "unconsumed:cmd+;=reload_config"


# 分割ペインのフォーカス移動キーバインド
keybind = "ctrl+opt+shift+l=goto_split:right"
keybind = "ctrl+opt+shift+h=goto_split:left"
keybind = "ctrl+opt+shift+k=goto_split:top"
keybind = "ctrl+opt+shift+j=goto_split:bottom"
keybind = "ctrl+opt+shift+tab=goto_split:next"

# 分割したペインのリサイズキーバインド
keybind = "ctrl+shift+l=resize_split:right,20"
keybind = "ctrl+shift+h=resize_split:left,20"
keybind = "ctrl+shift+k=resize_split:up,20"
keybind = "ctrl+shift+j=resize_split:down,20"
keybind = "shift+enter=text:\n"

# 選択したテキストをクリップボードにコピーする
keybind = "super+c=copy_to_clipboard"
# クリップボードから貼り付けする
keybind = "super+v=paste_from_clipboard"
