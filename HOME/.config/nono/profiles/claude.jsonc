{
  "extends": [
    "nolabs-ai/claude"
  ],
  "meta": {
    "name": "claude",
    "version": "",
    "description": "nolabs-ai/claudeを拡張し、~/.claude/settings.jsonのpermissions.denyをOSカーネルレベルで補強するClaude Code用サンドボックス",
    "author": null
  },
  "security": {
    "signal_mode": "allow_all",
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": null,
    "approval_backends": {},
    "approval_defaults": null,
    "wsl2_proxy_policy": null
  },
  "groups": {
    "include": [],
    "exclude": []
  },
  "commands": {
    "allow": [],
    "deny": []
  },
  "filesystem": {
    "allow": [
      "$HOME/.cache/mise",
      "$HOME/.local/state/mise",
      "$HOME/.npm",
      "$HOME/.cache/uv",
      "$HOME/.local/share/uv",
      "$HOME/.serena",
      "$HOME/.local/share/pnpm",
      "~/.config/.semgrep",
      "~/.config/gh",
      "$HOME/.crit",
      "$HOME/.dev",
      "~/Library/Application Support/tuicr",
      "$HOME/.local/share/gwm",
      "$HOME/.config/ponytail",
      "~/Library/Caches/claude-cli-nodejs/-Users-sugawarayss-PROJECTS-sugawarayss-dotfiles/mcp-logs-chrome-devtools",
      "~/Library/Caches/claude-cli-nodejs/-Users-sugawarayss-PROJECTS-sugawarayss-dotfiles/mcp-logs-context7",
      "~/Library/Caches/claude-cli-nodejs/-Users-sugawarayss-PROJECTS-sugawarayss-dotfiles/mcp-logs-github",
      "~/Library/Caches/claude-cli-nodejs/-Users-sugawarayss-PROJECTS-sugawarayss-dotfiles/mcp-logs-mise",
      "~/Library/Caches/claude-cli-nodejs/-Users-sugawarayss-PROJECTS-sugawarayss-dotfiles/mcp-logs-serena",
      "//github.com/inapvision/flexio/issues"
    ],
    "read": [
      "$HOME/.local/share/mise",
      "$HOME/.config/mise",
      "$HOME/.config/gwm",
      "$HOME/PROJECTS/sugawarayss/dotfiles",
      "~/Library/Application Support/Ardia"
    ],
    "write": [],
    "allow_file": [],
    "read_file": [
      "~/.config/anthropic/active_config",
      "~/.config/anthropic/configs/default.json",
      "~/.crit.config.json",
      "~/Library/Application Support/com.ardia.browser/Chromium/ArdiaControl.json"
    ],
    "write_file": [],
    "unix_socket": [
      "~/.config/herdr/herdr.sock"
    ],
    "unix_socket_bind": [],
    "unix_socket_dir": [],
    "unix_socket_dir_bind": [],
    "unix_socket_subtree": [],
    "unix_socket_subtree_bind": [],
    "deny": [
      "$HOME/PROJECTS/sugawarayss/dotfiles/HOME/.npmrc",
      "$HOME/PROJECTS/sugawarayss/dotfiles/HOME/.zshrc",
      "$HOME/PROJECTS/sugawarayss/dotfiles/HOME/.zprofile",
      "$HOME/PROJECTS/sugawarayss/dotfiles/HOME/.zsh.d",
      "$HOME/PROJECTS/sugawarayss/dotfiles/HOME/.config/fish",
      "**/.env",
      "**/.env.local",
      "**/.env.development",
      "**/.env.development.local",
      "**/.env.dev",
      "**/.env.dev.local",
      "**/.env.production",
      "**/.env.production.local",
      "**/.env.prod",
      "**/.env.prod.local",
      "**/.env.staging",
      "**/.env.staging.local",
      "**/.env.stag",
      "**/.env.stag.local",
      "**/.env.test",
      "**/.env.test.local",
      "**/*.pem",
      "**/*.key",
      "**/secrets/**",
      "**/id_rsa",
      "**/id_ed25519",
      "**/*.tfstate"
    ],
    "bypass_protection": [],
    "suppress_save_prompt": [
      "~/"
    ]
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [],
    "deny_domain": [],
    "open_port": [],
    "open_port_range": [],
    "listen_port": [],
    "listen_port_range": [],
    "connect_port": [],
    "no_proxy": [],
    "custom_credentials": {},
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": [],
    "approval_backends": {},
    "approval_defaults": null
  },
  "diagnostics": {
    "suppress_system_services": [],
    "redaction": {
      "extra_env_vars": []
    },
    "network_denial_audit": {}
  },
  "linux": {
    "af_unix_mediation": null,
    "sandbox_policy": null
  },
  "env_credentials": {},
  "command_policies": {
    "executable_dirs": [],
    "allow_writable_executables": false,
    "entrypoint": null,
    "approval_backends": {},
    "approval_defaults": {
      "backend": null,
      "timeout_secs": null
    },
    "credentials": {},
    "commands": {
      "curl": {
        "executable": null,
        "allow_writable_executable": false,
        "can_use": [],
        "export_env": [],
        "sandbox": null,
        "from": {
          "session": "deny"
        },
        "allow_direct_exec_bypass": [],
        "allow_direct_exec_bypass_with_credentials": false
      },
      "mo": {
        "executable": null,
        "allow_writable_executable": false,
        "can_use": [],
        "export_env": [],
        "sandbox": null,
        "from": {
          "session": "deny"
        },
        "allow_direct_exec_bypass": [],
        "allow_direct_exec_bypass_with_credentials": false
      },
      "nc": {
        "executable": null,
        "allow_writable_executable": false,
        "can_use": [],
        "export_env": [],
        "sandbox": null,
        "from": {
          "session": "deny"
        },
        "allow_direct_exec_bypass": [],
        "allow_direct_exec_bypass_with_credentials": false
      },
      "ncat": {
        "executable": null,
        "allow_writable_executable": false,
        "can_use": [],
        "export_env": [],
        "sandbox": null,
        "from": {
          "session": "deny"
        },
        "allow_direct_exec_bypass": [],
        "allow_direct_exec_bypass_with_credentials": false
      },
      "open": {
        "executable": null,
        "allow_writable_executable": false,
        "can_use": [],
        "export_env": [],
        "sandbox": null,
        "from": {
          "session": "deny"
        },
        "allow_direct_exec_bypass": [],
        "allow_direct_exec_bypass_with_credentials": false
      },
      "osascript": {
        "executable": null,
        "allow_writable_executable": false,
        "can_use": [],
        "export_env": [],
        "sandbox": null,
        "from": {
          "session": "deny"
        },
        "allow_direct_exec_bypass": [],
        "allow_direct_exec_bypass_with_credentials": false
      },
      "pbcopy": {
        "executable": null,
        "allow_writable_executable": false,
        "can_use": [],
        "export_env": [],
        "sandbox": null,
        "from": {
          "session": "deny"
        },
        "allow_direct_exec_bypass": [],
        "allow_direct_exec_bypass_with_credentials": false
      },
      "pbpaste": {
        "executable": null,
        "allow_writable_executable": false,
        "can_use": [],
        "export_env": [],
        "sandbox": null,
        "from": {
          "session": "deny"
        },
        "allow_direct_exec_bypass": [],
        "allow_direct_exec_bypass_with_credentials": false
      },
      "shred": {
        "executable": null,
        "allow_writable_executable": false,
        "can_use": [],
        "export_env": [],
        "sandbox": null,
        "from": {
          "session": "deny"
        },
        "allow_direct_exec_bypass": [],
        "allow_direct_exec_bypass_with_credentials": false
      },
      "telnet": {
        "executable": null,
        "allow_writable_executable": false,
        "can_use": [],
        "export_env": [],
        "sandbox": null,
        "from": {
          "session": "deny"
        },
        "allow_direct_exec_bypass": [],
        "allow_direct_exec_bypass_with_credentials": false
      },
      "wget": {
        "executable": null,
        "allow_writable_executable": false,
        "can_use": [],
        "export_env": [],
        "sandbox": null,
        "from": {
          "session": "deny"
        },
        "allow_direct_exec_bypass": [],
        "allow_direct_exec_bypass_with_credentials": false
      }
    },
    "deny_direct_exec_bypass": [],
    "session_export_env": []
  },
  "credential_capture": {},
  "credential_providers": {},
  "credential_routes": [],
  "workdir": {
    "access": "none"
  },
  "hooks": {},
  "session_hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": []
  },
  "allow_launch_services": false,
  "skipdirs": [],
  "packs": [],
  "command_args": [],
  "unsafe_macos_seatbelt_rules": []
}
